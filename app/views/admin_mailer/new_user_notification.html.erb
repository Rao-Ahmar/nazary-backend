<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 480px; margin: 0 auto; padding: 40px 20px;">
  <div style="text-align: center; margin-bottom: 32px;">
    <h1 style="font-size: 24px; font-weight: 600; color: #1a1c1d; margin: 0;">Nazary</h1>
    <p style="color: #6b7280; font-size: 14px; margin-top: 4px;">New User Registration</p>
  </div>

  <div style="background: #f9fafb; border-radius: 12px; padding: 32px;">
    <p style="color: #374151; font-size: 15px; margin: 0 0 16px;">A new user has joined Nazary!</p>

    <table style="width: 100%; border-collapse: collapse;">
      <tr>
        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Name</td>
        <td style="padding: 8px 0; color: #1a1c1d; font-size: 14px; font-weight: 600;"><%= @user.name %></td>
      </tr>
      <tr>
        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Email</td>
        <td style="padding: 8px 0; color: #1a1c1d; font-size: 14px;"><%= @user.email %></td>
      </tr>
      <tr>
        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Role</td>
        <td style="padding: 8px 0; color: #1a1c1d; font-size: 14px; text-transform: capitalize;"><%= @user.role %></td>
      </tr>
      <tr>
        <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Joined</td>
        <td style="padding: 8px 0; color: #1a1c1d; font-size: 14px;"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
      </tr>
    </table>
  </div>

  <p style="color: #9ca3af; font-size: 12px; text-align: center; margin-top: 24px;">
    This is an automated notification from Nazary.
  </p>
</div>
