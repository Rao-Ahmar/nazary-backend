<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 480px; margin: 0 auto; padding: 40px 20px;">
  <div style="text-align: center; margin-bottom: 32px;">
    <h1 style="font-size: 24px; font-weight: 600; color: #1a1c1d; margin: 0;">Nazary</h1>
    <p style="color: #6b7280; font-size: 14px; margin-top: 4px;">Phone Verification</p>
  </div>

  <div style="background: #f9fafb; border-radius: 12px; padding: 32px; text-align: center;">
    <p style="color: #374151; font-size: 15px; margin: 0 0 8px;">Your verification code for <strong><%= @phone_number %></strong> is:</p>

    <div style="background: #ffffff; border: 2px solid #e5e7eb; border-radius: 8px; padding: 16px; margin: 20px 0;">
      <span style="font-size: 32px; font-weight: 700; letter-spacing: 8px; color: #1a1c1d;"><%= @code %></span>
    </div>

    <p style="color: #9ca3af; font-size: 13px; margin: 0;">This code expires in <strong>5 minutes</strong>.</p>
  </div>

  <p style="color: #9ca3af; font-size: 12px; text-align: center; margin-top: 24px;">
    If you didn't request this code, you can safely ignore this email.
  </p>
  <p style="color: #9ca3af; font-size: 12px; text-align: center; margin-top: 8px;">
    Didn't see this email in your inbox? Please check your spam or junk folder.
  </p>
</div>
